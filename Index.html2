<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#020914">
<title>JARVIS LAB — Quest 3S</title>
<style>
:root{--cyan:#65eaff;--blue:#159bff;--deep:#03101e;--glass:rgba(5,25,48,.88);--muted:#91b9ca;--line:#258bb5}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#020914;color:#dffaff;font-family:Arial,Helvetica,sans-serif}
#scene{position:fixed;inset:0}
#hud{position:fixed;inset:0;pointer-events:none;padding:clamp(10px,2vw,20px);display:flex;flex-direction:column;justify-content:space-between;gap:10px}
.top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.brand{font-size:clamp(16px,2.4vw,28px);letter-spacing:.2em;color:var(--cyan);text-shadow:0 0 16px #00bfff}.sub{font-size:10px;letter-spacing:.16em;color:#8abfd7;margin-top:6px}
.statuses{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.status{border:1px solid #2c9fc7;background:rgba(0,18,36,.78);padding:8px 10px;font-size:10px;letter-spacing:.08em;color:#9cecff}
.bottom{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;pointer-events:auto}button{background:linear-gradient(135deg,rgba(0,110,180,.9),rgba(0,35,72,.96));color:#dffaff;border:1px solid #46cfff;padding:10px 13px;border-radius:3px;letter-spacing:.08em;font-weight:bold;box-shadow:0 0 18px #008bd344;cursor:pointer}button:active{background:#087eb4}button.primary{background:linear-gradient(135deg,#087fc4,#06436f)}button:disabled{opacity:.5;cursor:default}
#panel{position:fixed;left:clamp(10px,2vw,20px);top:92px;width:min(420px,calc(100vw - 20px));max-height:calc(100vh - 175px);overflow:auto;padding:15px;border:1px solid #39bce8;background:var(--glass);box-shadow:0 0 28px #008bd344;backdrop-filter:blur(12px);pointer-events:auto;scrollbar-color:#1688ae #051423}
h2{font-size:14px;letter-spacing:.16em;color:var(--cyan);margin:0 0 9px}p{font-size:12px;line-height:1.5;color:#b9dce9;margin:8px 0}.toolbar{display:flex;gap:6px;margin:10px 0}.toolbar input,.chat input{min-width:0;flex:1;background:#061a2b;border:1px solid #23799a;color:white;padding:10px;border-radius:2px}.toolbar button{padding:9px 11px}
#elements{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:5px;max-height:220px;overflow:auto;padding:2px}.element{min-height:52px;text-align:left;padding:5px;background:rgba(0,75,115,.35);border:1px solid #258bb5;box-shadow:none;letter-spacing:0}.element b{display:block;font-size:17px;color:#8cf1ff}.element small{display:block;font-size:8px;color:#b5dbe8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.element.selected{outline:2px solid #fff;box-shadow:0 0 12px #39bce8}
#elementInfo{border-left:2px solid var(--cyan);padding:7px 10px;margin:10px 0;background:#031b2c}.info-title{color:#8cf1ff;font-weight:bold}.chips{display:flex;gap:5px;flex-wrap:wrap}.chip{border:1px solid #23799a;color:#b8edfa;padding:4px 7px;font-size:9px;letter-spacing:.08em}
#log{font-size:12px;line-height:1.45;color:#a8e7f4;min-height:36px;padding:8px;background:rgba(0,13,26,.55);border-left:2px solid #159bff;margin-top:8px}.chat{display:flex;gap:6px;margin-top:8px}.chat button{padding:9px 11px}.help{font-size:10px!important;color:#83aebe!important}#notice{position:fixed;bottom:62px;left:50%;transform:translateX(-50%);background:#031a2a;border:1px solid #37bde9;padding:8px 12px;font-size:10px;color:#bdf6ff;pointer-events:none;text-align:center;max-width:92vw}.hidden{display:none!important}
@media(max-width:600px){#panel{top:82px;max-height:calc(100vh - 155px);padding:11px}.status{font-size:8px;padding:6px}.bottom button{padding:9px 10px;font-size:9px}#elements{grid-template-columns:repeat(5,minmax(0,1fr));max-height:180px}.sub{max-width:48vw;font-size:8px}}
</style>
</head>
<body>
<div id="scene"></div>
<div id="hud">
 <div class="top">
  <div><div class="brand">J A R V I S&nbsp; / &nbsp;L A B</div><div class="sub">PERSONAL SCIENTIFIC RESEARCH SYSTEM · QUEST EDITION</div></div>
  <div class="statuses"><div class="status" id="connection">SYSTEM ONLINE · LOCAL KNOWLEDGE</div><div class="status" id="handStatus">HANDS · WAITING FOR VR</div><div class="status" id="voiceStatus">VOICE · READY</div></div>
 </div>
 <div class="bottom">
  <button class="primary" id="vr">ENTER VR</button><button id="elementsBtn">PERIODIC TABLE</button><button id="moleculeBtn">WATER MOLECULE</button><button id="voiceBtn">START LISTENING</button><button id="speakBtn">SPEECH ON</button>
 </div>
</div>
<section id="panel">
 <h2 id="panelTitle">WELCOME BACK, RESEARCHER</h2>
 <p id="intro">JARVIS is ready. Browse all 118 elements, explore a molecule, type a question, or use voice commands. In VR, pinch your thumb and index finger while pointing at an atom to select it.</p>
 <div class="toolbar"><input id="elementSearch" type="search" placeholder="Find an element by name, symbol, or number…" aria-label="Search elements"><button id="clearSearch" title="Clear search">CLEAR</button></div>
 <div id="elements" aria-label="118 chemical elements"></div>
 <div id="elementInfo"><span class="info-title">LAB NOTE</span><p id="elementDescription">Select an element to hear a short introduction and see its atomic number and category.</p><div class="chips" id="elementFacts"></div></div>
 <div id="log" aria-live="polite">JARVIS: Laboratory systems initialized. How may I assist?</div>
 <div class="chat"><input id="prompt" placeholder="Ask JARVIS or enter a command…" autocomplete="off"><button id="send">SEND</button></div>
 <p class="help">Try: “Tell me about neon,” “select element 79,” “show water,” “show the periodic table,” “what can you do,” or “stop speaking.” Your browser’s speech recognition and speech synthesis availability may vary.</p>
 <p class="help">Assistant mode: built-in science knowledge and commands; spoken responses use your device’s text-to-speech. A connected generative AI requires a separate secure server—never put a private API key in this HTML file.</p>
</section>
<div id="notice">For Quest 3S: open this page in Meta Quest Browser over HTTPS, then choose ENTER VR. Hand tracking must be enabled in Quest settings.</div>
<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

const elementRows = `
H|Hydrogen|nonmetal;He|Helium|noble gas;Li|Lithium|alkali metal;Be|Beryllium|alkaline earth metal;B|Boron|metalloid;C|Carbon|nonmetal;N|Nitrogen|nonmetal;O|Oxygen|nonmetal;F|Fluorine|halogen;Ne|Neon|noble gas;
Na|Sodium|alkali metal;Mg|Magnesium|alkaline earth metal;Al|Aluminium|post-transition metal;Si|Silicon|metalloid;P|Phosphorus|nonmetal;S|Sulfur|nonmetal;Cl|Chlorine|halogen;Ar|Argon|noble gas;
K|Potassium|alkali metal;Ca|Calcium|alkaline earth metal;Sc|Scandium|transition metal;Ti|Titanium|transition metal;V|Vanadium|transition metal;Cr|Chromium|transition metal;Mn|Manganese|transition metal;Fe|Iron|transition metal;Co|Cobalt|transition metal;Ni|Nickel|transition metal;Cu|Copper|transition metal;Zn|Zinc|transition metal;Ga|Gallium|post-transition metal;Ge|Germanium|metalloid;As|Arsenic|metalloid;Se|Selenium|nonmetal;Br|Bromine|halogen;Kr|Krypton|noble gas;
Rb|Rubidium|alkali metal;Sr|Strontium|alkaline earth metal;Y|Yttrium|transition metal;Zr|Zirconium|transition metal;Nb|Niobium|transition metal;Mo|Molybdenum|transition metal;Tc|Technetium|transition metal;Ru|Ruthenium|transition metal;Rh|Rhodium|transition metal;Pd|Palladium|transition metal;Ag|Silver|transition metal;Cd|Cadmium|transition metal;In|Indium|post-transition metal;Sn|Tin|post-transition metal;Sb|Antimony|metalloid;Te|Tellurium|metalloid;I|Iodine|halogen;Xe|Xenon|noble gas;
Cs|Caesium|alkali metal;Ba|Barium|alkaline earth metal;La|Lanthanum|lanthanoid;Ce|Cerium|lanthanoid;Pr|Praseodymium|lanthanoid;Nd|Neodymium|lanthanoid;Pm|Promethium|lanthanoid;Sm|Samarium|lanthanoid;Eu|Europium|lanthanoid;Gd|Gadolinium|lanthanoid;Tb|Terbium|lanthanoid;Dy|Dysprosium|lanthanoid;Ho|Holmium|lanthanoid;Er|Erbium|lanthanoid;Tm|Thulium|lanthanoid;Yb|Ytterbium|lanthanoid;Lu|Lutetium|lanthanoid;Hf|Hafnium|transition metal;Ta|Tantalum|transition metal;W|Tungsten|transition metal;Re|Rhenium|transition metal;Os|Osmium|transition metal;Ir|Iridium|transition metal;Pt|Platinum|transition metal;Au|Gold|transition metal;Hg|Mercury|transition metal;Tl|Thallium|post-transition metal;Pb|Lead|post-transition metal;Bi|Bismuth|post-transition metal;Po|Polonium|post-transition metal;At|Astatine|halogen;Rn|Radon|noble gas;
Fr|Francium|alkali metal;Ra|Radium|alkaline earth metal;Ac|Actinium|actinoid;Th|Thorium|actinoid;Pa|Protactinium|actinoid;U|Uranium|actinoid;Np|Neptunium|actinoid;Pu|Plutonium|actinoid;Am|Americium|actinoid;Cm|Curium|actinoid;Bk|Berkelium|actinoid;Cf|Californium|actinoid;Es|Einsteinium|actinoid;Fm|Fermium|actinoid;Md|Mendelevium|actinoid;No|Nobelium|actinoid;Lr|Lawrencium|actinoid;Rf|Rutherfordium|transition metal;Db|Dubnium|transition metal;Sg|Seaborgium|transition metal;Bh|Bohrium|transition metal;Hs|Hassium|transition metal;Mt|Meitnerium|unknown;Ds|Darmstadtium|unknown;Rg|Roentgenium|unknown;Cn|Copernicium|transition metal;Nh|Nihonium|unknown;Fl|Flerovium|unknown;Mc|Moscovium|unknown;Lv|Livermorium|unknown;Ts|Tennessine|halogen;Og|Oganesson|noble gas`;
const elements=elementRows.trim().split(/[;\n]/).filter(Boolean).map((row,i)=>{const [symbol,name,category]=row.split('|');return{number:i+1,symbol,name,category}});
const byName=new Map(elements.map(e=>[e.name.toLowerCase(),e]));const bySymbol=new Map(elements.map(e=>[e.symbol.toLowerCase(),e]));
const colors={H:0xe8faff,C:0x888e9c,O:0xff5269,N:0x397cff,Fe:0xffa34a,Au:0xffd34e};
const categoryColor={'alkali metal':'#ffb463','alkaline earth metal':'#ffe27a','transition metal':'#93d8ff','post-transition metal':'#78e5cf','metalloid':'#ccadff','nonmetal':'#89ef9d','halogen':'#ff8b9e','noble gas':'#b19aff','lanthanoid':'#ffb4e2','actinoid':'#ff9a73','unknown':'#a3b0bc'};
const $=id=>document.getElementById(id);let scene,camera,renderer,core,ring,raycaster;let atoms=[];let selected=null;let recognition=null;let listening=false;let speechEnabled=true;let lastSpoken='';let handPinches=new Map();let activeHandCount=0;
const host=$('scene');scene=new THREE.Scene();scene.background=new THREE.Color(0x020914);scene.fog=new THREE.FogExp2(0x020914,.02);camera=new THREE.PerspectiveCamera(65,innerWidth/innerHeight,.1,100);camera.position.set(0,1.55,5.5);
renderer=new THREE.WebGLRenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.xr.enabled=true;host.appendChild(renderer.domElement);
scene.add(new THREE.HemisphereLight(0x8beaff,0x06142a,2));const key=new THREE.PointLight(0x21bfff,32,15);key.position.set(0,2,1);scene.add(key);

// ===== UPDATE 1: LABORATORY ENVIRONMENT (floor at y=0 = Quest local-floor) =====
const lab=new THREE.Group();scene.add(lab);const labPulse=[];const labSpin=[];
const R=10,H=5,TZ=-1.7;
const metal=(c,r=.4,m=.6)=>new THREE.MeshStandardMaterial({color:c,metalness:m,roughness:r});
const glow=(c,o=1,side=THREE.DoubleSide)=>new THREE.MeshBasicMaterial({color:c,transparent:true,opacity:o,blending:THREE.AdditiveBlending,depthWrite:false,side});
const flat=m=>{m.rotation.x=-Math.PI/2;return m};
lab.add(flat(new THREE.Mesh(new THREE.CircleGeometry(R,64),metal(0x0b141e,.3,.6))));
[2,4.2,6.5,9.4].forEach(r=>{const m=flat(new THREE.Mesh(new THREE.RingGeometry(r,r+.05,96),glow(0x19c8ff,.7)));m.position.y=.01;lab.add(m);labPulse.push(m)});
for(let i=0;i<16;i++){const p=new THREE.Group();p.rotation.y=i/16*Math.PI*2;const l=flat(new THREE.Mesh(new THREE.PlaneGeometry(.04,R-2.4),glow(0x0e8fc7,.4)));l.position.set(0,.011,-(2+(R-2.4)/2));p.add(l);lab.add(p)}
const wall=new THREE.Mesh(new THREE.CylinderGeometry(R,R,H,48,1,true),metal(0x0c141d,.5,.5));wall.material.side=THREE.BackSide;wall.position.y=H/2;lab.add(wall);
for(let i=0;i<24;i++){const a=i/24*Math.PI*2,g=new THREE.Group();g.position.set(Math.sin(a)*(R-.12),H/2,Math.cos(a)*(R-.12));g.rotation.y=a;g.add(new THREE.Mesh(new THREE.BoxGeometry(.3,H,.2),metal(0x101c28,.4,.7)));const s=new THREE.Mesh(new THREE.PlaneGeometry(.03,H-.4),glow(0x2ad4ff,.8));s.position.set(0,0,-.101);s.rotation.y=Math.PI;g.add(s);lab.add(g)}
[.9,3.7].forEach(y=>{const b=new THREE.Mesh(new THREE.CylinderGeometry(R-.2,R-.2,.06,64,1,true),glow(0x19c8ff,.55,THREE.BackSide));b.position.y=y;lab.add(b);labPulse.push(b)});
const ceil=new THREE.Mesh(new THREE.CircleGeometry(R,48),metal(0x070d14,.6,.4));ceil.rotation.x=Math.PI/2;ceil.position.y=H;lab.add(ceil);
[2.6,5].forEach(r=>{const c=new THREE.Mesh(new THREE.RingGeometry(r,r+.06,64),glow(0x4fe0ff,.8));c.rotation.x=Math.PI/2;c.position.y=H-.01;lab.add(c)});
// Central command table (the existing hologram floats above it)
const tbl=new THREE.Group();tbl.position.set(0,0,TZ);lab.add(tbl);
const tb=new THREE.Mesh(new THREE.CylinderGeometry(.5,.7,.72,32),metal(0x182535,.35,.8));tb.position.y=.36;tbl.add(tb);
const tt=new THREE.Mesh(new THREE.CylinderGeometry(1.25,1.15,.1,64),metal(0x101a26,.25,.8));tt.position.y=.77;tbl.add(tt);
const tr=new THREE.Mesh(new THREE.TorusGeometry(1.22,.025,8,96),glow(0x5fe6ff,.95));tr.rotation.x=Math.PI/2;tr.position.y=.83;tbl.add(tr);
const td=flat(new THREE.Mesh(new THREE.RingGeometry(.35,.9,64),glow(0x1aa8e8,.35)));td.position.y=.825;tbl.add(td);labPulse.push(td);labSpin.push(tr);
// Wall displays: decorative readouts only (labelled SIMULATED), not live data
function screenTex(title,seed){const c=document.createElement('canvas');c.width=512;c.height=288;const x=c.getContext('2d');x.fillStyle='#02111d';x.fillRect(0,0,512,288);x.strokeStyle='#27c3f0';x.lineWidth=3;x.strokeRect(4,4,504,280);x.fillStyle='#8cf1ff';x.font='bold 26px Arial';x.fillText(title,20,44);x.font='14px Arial';x.fillStyle='#5fa8c2';x.fillText('SIMULATED DISPLAY',20,66);let s=seed*9301+49297;const rnd=()=>(s=(s*9301+49297)%233280)/233280;for(let i=0;i<14;i++){x.fillStyle='rgba(40,190,240,.75)';const h=20+rnd()*110;x.fillRect(24+i*22,270-h,16,h)}x.strokeStyle='#bff6ff';x.lineWidth=2;x.beginPath();for(let i=0;i<=40;i++){const px=340+i*4,py=130+Math.sin(i*.5+seed)*26*rnd();i?x.lineTo(px,py):x.moveTo(px,py)}x.stroke();x.fillStyle='#8cf1ff';x.font='bold 40px Arial';x.fillText(String(Math.round(40+rnd()*55))+'%',350,230);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t}
['POWER GRID','STRUCTURAL SCAN','ATMOSPHERE','SYSTEM LOAD','NETWORK','THERMAL','COMMS'].forEach((n,i)=>{const a=(i-3)*.36,g=new THREE.Group();g.position.set(Math.sin(a)*(R-.4),2.1,-Math.cos(a)*(R-.4));g.rotation.y=-a;g.add(new THREE.Mesh(new THREE.BoxGeometry(2.35,1.4,.08),metal(0x101c28,.4,.7)));const sc=new THREE.Mesh(new THREE.PlaneGeometry(2.2,1.24),new THREE.MeshBasicMaterial({map:screenTex(n,i+1)}));sc.position.z=.05;g.add(sc);lab.add(g)});
const l1=new THREE.PointLight(0x2aaaff,16,12);l1.position.set(0,3.6,TZ);scene.add(l1);const l2=new THREE.PointLight(0x1e88e5,9,12);l2.position.set(0,3.2,4);scene.add(l2);
function labTick(t){labPulse.forEach((m,i)=>{m.material.opacity=.4+.3*Math.sin(t*1.6+i*1.1)});labSpin.forEach(m=>{m.rotation.z=t*.3})}

const ringMat=new THREE.MeshBasicMaterial({color:0x16cfff,wireframe:true,transparent:true,opacity:.65});ring=new THREE.Mesh(new THREE.TorusGeometry(1.55,.012,8,120),ringMat);ring.position.set(0,1.45,-1.7);scene.add(ring);
const coreMat=new THREE.MeshStandardMaterial({color:0x18bfff,emissive:0x006ca8,emissiveIntensity:2.4,metalness:.5,roughness:.2});core=new THREE.Mesh(new THREE.IcosahedronGeometry(.65,2),coreMat);core.position.set(0,1.45,-1.7);scene.add(core);const wire=new THREE.Mesh(new THREE.IcosahedronGeometry(.82,1),new THREE.MeshBasicMaterial({color:0x62eaff,wireframe:true,transparent:true,opacity:.38}));wire.position.copy(core.position);scene.add(wire);
function clearAtoms(){for(const a of atoms)scene.remove(a);atoms=[]}
function addAtom(symbol,x,y,z,color,size=.18){const g=new THREE.Group();const m=new THREE.Mesh(new THREE.SphereGeometry(size,24,18),new THREE.MeshStandardMaterial({color,emissive:color,emissiveIntensity:.55,metalness:.25,roughness:.25}));g.add(m);g.position.set(x,y,z);g.userData={symbol};scene.add(g);atoms.push(g);return g}
function molecule(){clearAtoms();addAtom('O',0,1.4,-1.8,colors.O,.28);addAtom('H',-.42,1.65,-1.8,colors.H,.17);addAtom('H',.42,1.65,-1.8,colors.H,.17);const bonds=[[-.21,1.525,-1.8],[.21,1.525,-1.8]].map(p=>{const mesh=new THREE.Mesh(new THREE.CylinderGeometry(.025,.025,.45,10),new THREE.MeshBasicMaterial({color:0x78eaff}));mesh.position.set(...p);mesh.rotation.z=Math.PI/4;scene.add(mesh);return mesh});window._jarvisBonds=bonds;setTitle('MOLECULAR WORKSPACE');say('Water molecule displayed. It contains two hydrogen atoms bonded to one oxygen atom.');}
function showElement(symbol,announce=true){const e=bySymbol.get(String(symbol).toLowerCase());if(!e)return;clearAtoms();if(window._jarvisBonds){window._jarvisBonds.forEach(o=>scene.remove(o));window._jarvisBonds=[]}const color=colors[e.symbol]||new THREE.Color(categoryColor[e.category]).getHex();addAtom(e.symbol,0,1.45,-1.7,color,.48);selected=e;renderElementInfo(e);document.querySelectorAll('.element').forEach(b=>b.classList.toggle('selected',b.dataset.symbol===e.symbol));if(announce)say(`${e.name}, atomic number ${e.number}. ${categoryDescription(e)}.`)}
function categoryDescription(e){return `${e.name} is classified as a ${e.category}.`}
function renderElementInfo(e){$('elementDescription').textContent=`${e.name} (${e.symbol}) is element ${e.number} on the periodic table. ${categoryDescription(e)} Its most common isotope and detailed properties can vary; consult a chemistry reference for laboratory use.`;$('elementFacts').innerHTML=`<span class="chip">ATOMIC NO. ${e.number}</span><span class="chip">${e.symbol.toUpperCase()}</span><span class="chip">${e.category.toUpperCase()}</span>`;$('panelTitle').textContent=`ELEMENT ANALYSIS · ${e.symbol.toUpperCase()}`}
function renderElementGrid(query=''){const q=query.trim().toLowerCase();const list=elements.filter(e=>!q||e.name.toLowerCase().includes(q)||e.symbol.toLowerCase().includes(q)||String(e.number)===q);$('elements').innerHTML='';for(const e of list){const b=document.createElement('button');b.className='element'+(selected?.number===e.number?' selected':'');b.dataset.symbol=e.symbol;b.style.borderColor=categoryColor[e.category]||'#258bb5';b.innerHTML=`<b>${e.symbol}</b><small>${e.number} · ${e.name}</small>`;b.title=`${e.name} — atomic number ${e.number} — ${e.category}`;b.addEventListener('click',()=>showElement(e.symbol));$('elements').appendChild(b)}$('elements').classList.remove('hidden');$('panelTitle').textContent=`PERIODIC TABLE · ${list.length} OF 118`;}
function setTitle(t){$('panelTitle').textContent=t}
function say(text,force=false){$('log').textContent='JARVIS: '+text;lastSpoken=text;if(speechEnabled&&('speechSynthesis'in window)&&(force||text)){speechSynthesis.cancel();const utterance=new SpeechSynthesisUtterance(text);utterance.rate=.96;utterance.pitch=.88;utterance.volume=1;const voices=speechSynthesis.getVoices();utterance.voice=voices.find(v=>/^en/i.test(v.lang)&&/Daniel|Alex|David|Google UK English Male/i.test(v.name))||voices.find(v=>/^en/i.test(v.lang))||null;speechSynthesis.speak(utterance)}}
function stopSpeaking(){if('speechSynthesis'in window)speechSynthesis.cancel();$('voiceStatus').textContent=listening?'VOICE · LISTENING':'VOICE · READY'}
function findElementFromQuestion(q){const s=q.toLowerCase();const byNumber=s.match(/(?:element|atomic number|number)\s*(?:is|number)?\s*(\d{1,3})/);if(byNumber){const n=Number(byNumber[1]);if(n>=1&&n<=118)return elements[n-1]}for(const e of elements){const name=e.name.toLowerCase();const sym=e.symbol.toLowerCase();if(new RegExp(`\\b${name}\\b`,'i').test(s))return e;if(sym.length>1&&new RegExp(`\\b${sym}\\b`,'i').test(s))return e}return null}
function answer(question){const q=question.trim();if(!q)return;const s=q.toLowerCase();if(/\b(stop|quiet|silence|stop talking|stop speaking)\b/.test(s)){stopSpeaking();$('log').textContent='JARVIS: Speech stopped.';return}if(/\b(repeat|say that again)\b/.test(s)){say(lastSpoken||'I am ready. What would you like to explore?');return}if(/\b(help|commands|what can you do)\b/.test(s)){say('I can search all 118 elements, tell you an element name and atomic number, show a water molecule, open the periodic table, listen to a voice command, and speak my replies. Try: tell me about neon, select element 79, or show water.');return}if(/\b(show|open|display|hide|browse)\b.*\b(periodic table|elements|element table)\b|\b(periodic table|all elements)\b/.test(s)){renderElementGrid($('elementSearch').value);say('The periodic table is open. It contains all 118 recognized elements.');return}if(/\b(water|molecule|h2o)\b/.test(s)){molecule();return}if(/\b(hello|hi jarvis|hey jarvis|good morning|good evening)\b/.test(s)){say('At your service. Laboratory systems are online. What shall we investigate?');return}if(/\b(time)\b/.test(s)){say(`The local time is ${new Intl.DateTimeFormat(undefined,{hour:'numeric',minute:'2-digit'}).format(new Date())}.`);return}const e=findElementFromQuestion(s);if(e){renderElementGrid($('elementSearch').value);showElement(e.symbol);return}say('I can answer basic periodic-table and molecule commands in this local prototype. Try naming an element, asking for an atomic number, saying show water, or asking what I can do.');}
function makeController(i){const controller=renderer.xr.getController(i);controller.addEventListener('selectstart',()=>{raycaster.setFromXRController(controller);const hits=raycaster.intersectObjects(atoms,true);if(hits.length){let o=hits[0].object;while(o.parent&&!o.userData.symbol)o=o.parent;if(o.userData.symbol)showElement(o.userData.symbol)}});scene.add(controller);const line=new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,0,0),new THREE.Vector3(0,0,-3)]),new THREE.LineBasicMaterial({color:0x50eaff}));controller.add(line);}
// Use the active WebXR hand joints: pinch thumb + index fingertip to select the object under the index finger.
function handleHandInput(frame){const session=renderer.xr.getSession();if(!session||!frame)return;const refSpace=renderer.xr.getReferenceSpace();if(!refSpace)return;let seen=0;for(const source of session.inputSources){if(!source.hand)continue;seen++;const hand=source.hand;const thumb=hand.get('thumb-tip'),tip=hand.get('index-finger-tip'),base=hand.get('index-finger-phalanx-distal');if(!thumb||!tip||!base)continue;const tp=frame.getJointPose(tip,refSpace),thp=frame.getJointPose(thumb,refSpace),bp=frame.getJointPose(base,refSpace);if(!tp||!thp||!bp)continue;const tipPos=new THREE.Vector3(tp.transform.position.x,tp.transform.position.y,tp.transform.position.z);const thumbPos=new THREE.Vector3(thp.transform.position.x,thp.transform.position.y,thp.transform.position.z);const basePos=new THREE.Vector3(bp.transform.position.x,bp.transform.position.y,bp.transform.position.z);const pinching=tipPos.distanceTo(thumbPos)<.035;let state=handPinches.get(source);if(!state){state={pinching:false};handPinches.set(source,state)}if(pinching&&!state.pinching){const direction=tipPos.clone().sub(basePos).normalize();raycaster.set(tipPos,direction);let hits=raycaster.intersectObjects(atoms,true);if(!hits.length){const near=atoms.map(a=>({a,d:a.position.distanceTo(tipPos)})).sort((a,b)=>a.d-b.d)[0];if(near&&near.d<.45){const sym=near.a.userData.symbol;if(sym)showElement(sym)}}else{let obj=hits[0].object;while(obj.parent&&!obj.userData.symbol)obj=obj.parent;if(obj.userData.symbol)showElement(obj.userData.symbol)}}state.pinching=pinching}activeHandCount=seen;$('handStatus').textContent=seen?`HANDS · ${seen} TRACKED`:'HANDS · NOT DETECTED'}
makeController(0);makeController(1);
$('vr').addEventListener('click',async()=>{if(!navigator.xr){say('This browser does not offer WebXR. Open this file from an HTTPS website in Meta Quest Browser.');return}try{const supported=await navigator.xr.isSessionSupported('immersive-vr');if(!supported){say('Immersive VR is not supported in this browser. Try Meta Quest Browser on your Quest 3S.');return}const options={optionalFeatures:['local-floor','bounded-floor','hand-tracking','dom-overlay'],domOverlay:{root:document.body}};const session=await navigator.xr.requestSession('immersive-vr',options);session.addEventListener('end',()=>{$('handStatus').textContent='HANDS · WAITING FOR VR';$('notice').textContent='VR session ended. Select ENTER VR to return.';handPinches.clear()});await renderer.xr.setSession(session);$('notice').textContent='VR ACTIVE · Pinch thumb and index finger while pointing at an atom to select it.';say('Virtual reality session active. Pinch to select a displayed atom.');}catch(e){say('VR could not start. Check Quest Browser permissions, HTTPS, and hand tracking settings. '+e.message)}});
$('elementsBtn').addEventListener('click',()=>{renderElementGrid($('elementSearch').value);say('The periodic table is ready. All 118 elements are available.');});$('moleculeBtn').addEventListener('click',molecule);
$('elementSearch').addEventListener('input',()=>renderElementGrid($('elementSearch').value));$('clearSearch').addEventListener('click',()=>{$('elementSearch').value='';renderElementGrid('');$('elementSearch').focus()});
$('send').addEventListener('click',()=>{const q=$('prompt').value.trim();if(q){$('prompt').value='';answer(q)}});$('prompt').addEventListener('keydown',e=>{if(e.key==='Enter')$('send').click()});
$('voiceBtn').addEventListener('click',()=>{const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){say('Speech recognition is not available in this browser. Try Meta Quest Browser or type your command below.');$('voiceStatus').textContent='VOICE · NOT SUPPORTED';return}if(listening&&recognition){recognition.stop();return}recognition=new SR();recognition.lang='en-US';recognition.interimResults=false;recognition.continuous=false;recognition.maxAlternatives=1;recognition.onstart=()=>{listening=true;$('voiceStatus').textContent='VOICE · LISTENING';$('voiceBtn').textContent='STOP LISTENING';say('Listening. What would you like me to do?')};recognition.onresult=e=>{const q=e.results[0][0].transcript;$('prompt').value=q;answer(q)};recognition.onerror=e=>{if(e.error!=='no-speech'&&e.error!=='aborted')say(`Voice input error: ${e.error}. You can type your command instead.`)};recognition.onend=()=>{listening=false;recognition=null;$('voiceStatus').textContent='VOICE · READY';$('voiceBtn').textContent='START LISTENING'};try{recognition.start()}catch(e){listening=false;say('Voice input could not start. Please try again or type your command.')}});
$('speakBtn').addEventListener('click',()=>{speechEnabled=!speechEnabled;$('speakBtn').textContent=speechEnabled?'SPEECH ON':'SPEECH OFF';if(!speechEnabled)stopSpeaking();else say('Voice responses are on.')});
addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
function animate(time,frame){const t=(time||performance.now())*.001;core.rotation.x=t*.22;core.rotation.y=t*.38;wire.rotation.x=-t*.16;wire.rotation.y=t*.24;ring.rotation.z=t*.18;labTick(t);if(frame)handleHandInput(frame);renderer.render(scene,camera)}renderer.setAnimationLoop(animate);
renderElementGrid();molecule();selected=null;$('elementDescription').textContent='Select an element to hear a short introduction and see its atomic number and category.';$('elementFacts').innerHTML='';setTitle('WELCOME BACK, RESEARCHER');say('JARVIS systems initialized. Browse the periodic table or ask me a question.');
</script>
</body>
</html>
